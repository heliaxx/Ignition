[sub_resource type="Shader" id="Shader_smoke"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_never, cull_disabled, unshaded;

// LOD noise smoke: the particle's age (COLOR.r ramps 0->1 over the lifetime,
// driven by the process material's color ramp) selects the noise texture's
// mipmap level, so the profile progressively blurs and dissolves as it ages.
uniform vec4 smoke_color : source_color = vec4(0.75, 0.75, 0.78, 1.0);
uniform sampler2D noise_tex;
uniform sampler2D mask_tex;
uniform float max_lod : hint_range(0.0, 10.0) = 8.0;
// Meters from the camera over which smoke fades in, so a ship flying through its own trail can see out.
uniform float near_fade_start = 5.0;
uniform float near_fade_end = 25.0;

void vertex() {
	// Particle billboard, keeping per-particle scale and rotation.
	mat4 mat_world = mat4(
		normalize(INV_VIEW_MATRIX[0]),
		normalize(INV_VIEW_MATRIX[1]),
		normalize(INV_VIEW_MATRIX[2]),
		MODEL_MATRIX[3]);
	mat_world = mat_world * mat4(
		vec4(cos(INSTANCE_CUSTOM.x), -sin(INSTANCE_CUSTOM.x), 0.0, 0.0),
		vec4(sin(INSTANCE_CUSTOM.x), cos(INSTANCE_CUSTOM.x), 0.0, 0.0),
		vec4(0.0, 0.0, 1.0, 0.0),
		vec4(0.0, 0.0, 0.0, 1.0));
	mat_world = mat_world * mat4(
		vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0),
		vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0),
		vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0),
		vec4(0.0, 0.0, 0.0, 1.0));
	MODELVIEW_MATRIX = VIEW_MATRIX * mat_world;
	MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
}

void fragment() {
	float lod = mix(0.0, max_lod, COLOR.r);
	float noise = textureLod(noise_tex, UV, lod).r;
	float mask = texture(mask_tex, UV).r;
	ALBEDO = smoke_color.rgb;
	ALPHA = noise * mask * COLOR.a * smoke_color.a * smoothstep(near_fade_start, near_fade_end, length(VERTEX));
}
"

